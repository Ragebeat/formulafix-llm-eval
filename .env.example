# Copy to .env and fill in. The .env file is not committed.

# Password for the "formulafix" Postgres user. Must match docker-compose.yml.
POSTGRES_PASSWORD=

# Port on the host (127.0.0.1) that Postgres is published on. Used by
# docker-compose.yml and by the Python code, so change it in one place.
# POSTGRES_PORT=5440

# Full connection string. Overrides POSTGRES_PASSWORD and POSTGRES_PORT when set.
# DATABASE_URL=postgresql://formulafix:password@localhost:5440/formulafix

# LLM: any OpenAI-compatible endpoint. The baseline was measured on Groq.
# Groq retires models on short notice and has an output-tokens-per-minute cap
# on the free tier: record the exact model id and date next to every number.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=qwen/qwen3.8-27b
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024

# Tracing (optional): a running Phoenix. Use 127.0.0.1, not localhost (IPv6 fallback on Windows).
# PHOENIX_COLLECTOR_ENDPOINT=http://127.0.0.1:6006
# PHOENIX_PROJECT_NAME=formulafix
