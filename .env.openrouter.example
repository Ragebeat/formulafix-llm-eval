# Profile for running the model under test through OpenRouter.
# Copy to .env.openrouter, set the key, then in the shell:
#     $env:ENV_FILE = ".env.openrouter"        # PowerShell; applies to this window only
#     Remove-Item Env:ENV_FILE                 # back to the Groq settings in .env
# Only LLM_* keys belong here; Postgres settings stay in .env.
# The judge (judge.py) should run WITHOUT this profile: it uses the Groq settings
# on purpose (a model family different from the one under test).

LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
# An exact model id, not a "~...-latest" alias (an alias can move to a newer model).
LLM_MODEL=deepseek/deepseek-v4.1-flash
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024

# reasoning off: this model thinks by default, and its reasoning tokens would eat the
# max_tokens budget and cut answers off. usage.include makes OpenRouter report the cost.
# provider: OpenRouter spreads requests over ~30 providers of this model with different
# quantization (fp4 / fp8 / unknown), which is noise unrelated to the model itself.
# Pinned to one endpoint (DeepInfra, fp8), no fallbacks; require_parameters makes a
# provider that would ignore the reasoning switch ineligible instead of silently dropping
# it. The vendor's own endpoint was excluded by the account's data policy (it may train
# on paid-model prompts); with that policy relaxed, "deepseek" is the other candidate.
LLM_EXTRA_BODY={"reasoning":{"enabled":false},"usage":{"include":true},"provider":{"only":["deepinfra/fp8"],"allow_fallbacks":false,"require_parameters":true}}
